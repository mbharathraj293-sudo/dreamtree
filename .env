# DATABASE CONFIGURATION
# Set your PostgreSQL connection URL below
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dreamingtree?schema=public"

# APP CONFIGURATION
PORT=5000
NODE_ENV=development

# SECURITY CONFIGURATION
# Replace with a strong cryptographic key in production
JWT_SECRET="dreaming_tree_luxury_secret_key_2026_jwt_token"

# SMTP CONFIGURATION (For email confirmations and password resets)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="placeholder_user"
SMTP_PASS="placeholder_pass"
SMTP_FROM="no-reply@thedreamingtree.in"

# BRAND SETTINGS
ADMIN_OTP_ENABLED=false
